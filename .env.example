# 豊聡耳 環境変数サンプル
# このファイルを .env にコピーして値を設定してください。

# クラウド処理(AssemblyAI)を使う場合に必要な API キー
# https://www.assemblyai.com/ で取得できます。
ASSEMBLYAI_API_KEY=

# ローカル処理(pyannote.audio)を使う場合に必要な Hugging Face トークン
# https://huggingface.co/settings/tokens で取得し、
# pyannote/speaker-diarization-3.1 の利用規約に同意してください(無料)。
HF_TOKEN=
